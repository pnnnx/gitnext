     return proc.returncode, out
 
 
+def before_prompt(ctx, prompt: str) -> str:
+    """Команды before_prompt: их вывод (при коде 0) добавляется к запросу пользователя."""
+    cmds = commands(ctx.cfg, "before_prompt")
+    if not cmds:
+        return ""
+    timeout = int(ctx.cfg.get("hook_timeout", 120))
+    limit = int(ctx.cfg.get("before_prompt_max_chars", MAX_PROMPT_CONTEXT))
+    parts = []
+    for cmd in cmds:
+        code, out = _run_one(cmd, ctx.cwd, min(timeout, 30), stdin_text=prompt, max_out=limit)
+        if code == 0 and out:
+            parts.append(out)
+    return "\n\n".join(parts)
+

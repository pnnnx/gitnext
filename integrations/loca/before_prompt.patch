+    main(["-p", "--yolo", "--host", fake.url, "-m", "fake:1b", "--cwd", str(tmp_path), "fix brief"])
+    fake.close()
+    users = [m["content"] for m in fake.requests[0]["messages"] if m["role"] == "user"]
+    assert users[0].startswith("fix brief") and "FIX BRIEF" in users[0]
+    assert "noise" not in users[0] and "nope" not in users[0]
